error=false

# Vérification de la notice
if ./mvnw notice:check; then
  echo "Notice OK"
else
  error=true
  echo "Fix notice"
  ./mvnw notice:generate
fi

# Vérification de la licence
if ./mvnw license:check; then
  echo "License OK"
else
  error=true
  echo "Fix license"
  ./mvnw license:format
fi

# Vérification des erreurs
if $error; then
  exit 1;
fi
